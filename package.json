{
  "name": "holoself-ai",
  "version": "0.8.0",
  "description": "A local, reviewable self-context layer for AI tools",
  "type": "module",
  "bin": { "holoself": "bin/holoself.mjs" },
  "files": ["bin", "src", "web", "skills", "contribs", "docs", "schemas", "templates", "README.md", "CHANGELOG.md", "PRIVACY.md", "LICENSE"],
  "engines": { "node": ">=20" },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "start": "node bin/holoself.mjs",
    "web": "node bin/holoself.mjs web",
    "audit:package": "node scripts/package-audit.mjs",
    "verify": "node scripts/verify.mjs",
    "prepack": "npm run audit:package"
  },
  "license": "MIT"
}
