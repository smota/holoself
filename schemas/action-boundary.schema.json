{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentflow.dev/schemas/action-boundary.schema.json",
  "title": "AgentFlow Action Boundary",
  "type": "object",
  "required": ["version", "profile", "requested", "effective"],
  "properties": {
    "version": { "const": 1 },
    "profile": { "type": "string", "minLength": 1 },
    "requested": { "type": "string", "minLength": 1 },
    "effective": { "type": "string", "minLength": 1 },
    "parent": { "type": "string" },
    "owningRole": { "type": "string" },
    "humanApprovalRef": { "$ref": "artifact-ref.schema.json" },
    "enforcementRefs": { "type": "array", "items": { "$ref": "artifact-ref.schema.json" } }
  },
  "additionalProperties": true
}
