{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://holoself.local/schemas/lens.schema.json",
  "title": "Holoself lens definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "maxLength": 40,
      "not": {
        "const": "bindings"
      }
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "sensitivity_access": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "compensation-confidential",
          "third-party-personal",
          "recruiter-confidential",
          "employer-confidential",
          "application-private",
          "restricted"
        ]
      }
    },
    "instructions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "purpose": {
          "type": "string"
        },
        "priorities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "include": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "response_guidance": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "id": {
            "not": {
              "const": "private"
            }
          }
        }
      },
      "then": {
        "properties": {
          "sensitivity_access": {
            "items": {
              "not": {
                "const": "restricted"
              }
            }
          }
        }
      }
    }
  ]
}
