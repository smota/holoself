{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Operational delivery bindings",
  "type": "object",
  "properties": {
    "source": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {
          "enum": ["local-preview", "github"]
        },
        "repo": {
          "type": "string",
          "minLength": 1
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "enum": ["v1", "segmented-v2"]
        }
      },
      "additionalProperties": false
    },
    "candidate": {
      "type": "object",
      "required": ["inputs"],
      "properties": {
        "inputs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "context": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "contracts": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "collaboration": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["id", "criterionId", "executable", "args", "assertions", "timeoutMs"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "criterionId": {
            "type": "string",
            "minLength": 1
          },
          "executable": {
            "type": "string",
            "minLength": 1
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "assertions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3600000
          },
          "env": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "inheritEnv": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "format": {
            "enum": ["structured", "junit-stdout", "exit-code"]
          }
        },
        "additionalProperties": false
      }
    },
    "probes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "profile", "executable", "args", "effect"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "profile": {
            "type": "string",
            "minLength": 1
          },
          "executable": {
            "type": "string",
            "minLength": 1
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "effect": {
            "enum": [
              "observe",
              "project-write",
              "network-read",
              "provider-execution",
              "external-mutation"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "expectedText": {
            "type": "string",
            "minLength": 1
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 60000
          }
        },
        "additionalProperties": false
      }
    },
    "budget": {
      "type": "object",
      "required": ["level", "limit"],
      "properties": {
        "level": {
          "enum": ["advisory", "admission-enforced", "provider-enforced"]
        },
        "limit": {
          "type": "number",
          "minimum": 0
        },
        "unit": {
          "type": "string"
        },
        "estimatedNext": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "delegation": {
      "type": "object",
      "required": ["policy", "issuerId", "reviewCheck"],
      "properties": {
        "policy": {
          "type": "object"
        },
        "issuerId": {
          "type": "string",
          "minLength": 1
        },
        "reviewCheck": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "engineeringProvider": {
      "type": "object",
      "required": ["id", "executionTarget"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "executionTarget": {
          "type": "string",
          "minLength": 1
        },
        "requestedModel": {
          "type": ["string", "null"]
        },
        "requiredCapabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "permissionBoundary": {
          "enum": ["observe", "propose", "mutate-worktree"]
        },
        "sourceEvidenceDisclosure": {
          "const": "bounded-output-and-artifacts"
        },
        "connection": {
          "additionalProperties": false,
          "properties": {
            "binarySha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "configFile": {
              "type": "string",
              "minLength": 1
            },
            "worktreeBase": {
              "type": "string",
              "minLength": 1
            },
            "dbFile": {
              "type": "string",
              "minLength": 1
            },
            "executable": {
              "type": "string",
              "minLength": 1
            }
          },
          "type": "object",
          "required": ["executable", "binarySha256", "configFile", "dbFile", "worktreeBase"]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
