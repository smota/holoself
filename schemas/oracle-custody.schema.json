{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentflow.dev/schemas/oracle-custody.schema.json",
  "title": "Native run oracle custody records",
  "type": "object",
  "required": [
    "version",
    "type",
    "digest",
    "runId",
    "goalRef",
    "runRevision",
    "sourceRevision",
    "generation",
    "revocationEpoch",
    "oracleDigest",
    "candidateDigest",
    "mode",
    "identity"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "type": {
      "enum": ["oracle-custody-request", "oracle-custody-receipt"]
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "runRevision": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "oracleDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "goalRef": {
      "type": "string",
      "minLength": 1
    },
    "sourceRevision": {
      "type": "string",
      "minLength": 1
    },
    "identity": {
      "type": "string",
      "minLength": 1
    },
    "generation": {
      "type": "integer",
      "minimum": 0
    },
    "revocationEpoch": {
      "type": "integer",
      "minimum": 0
    },
    "candidateDigest": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{64}$"
    },
    "mode": {
      "enum": ["historical-author", "prospective-assignment"]
    },
    "assignmentRef": {
      "allOf": [
        {
          "$ref": "artifact-ref.schema.json"
        },
        {
          "required": ["revision", "digest"],
          "properties": {
            "revision": {
              "type": "string",
              "minLength": 1
            },
            "digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      ]
    },
    "manifestRef": {
      "allOf": [
        {
          "$ref": "artifact-ref.schema.json"
        },
        {
          "required": ["revision", "digest"],
          "properties": {
            "revision": {
              "type": "string",
              "minLength": 1
            },
            "digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      ]
    },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "artifact-ref.schema.json"
      }
    },
    "provenance": {
      "type": "object",
      "required": ["platform", "executor"],
      "properties": {
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "executor": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "requestDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "authorIdentity": {
      "type": ["string", "null"]
    },
    "assigneeIdentity": {
      "type": ["string", "null"]
    },
    "verifier": {
      "type": "string",
      "minLength": 1
    },
    "verifiedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "oracle-custody-request"
          }
        }
      },
      "then": {
        "required": ["assignmentRef", "manifestRef", "evidenceRefs", "provenance"]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "oracle-custody-receipt"
          }
        }
      },
      "then": {
        "required": [
          "requestDigest",
          "authorIdentity",
          "assigneeIdentity",
          "verifier",
          "verifiedAt",
          "assignmentRef",
          "manifestRef",
          "evidenceRefs",
          "provenance"
        ]
      }
    }
  ],
  "additionalProperties": false
}
