{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://holoself.local/schemas/document-metadata.schema.json",
  "title": "Holoself canonical Markdown frontmatter",
  "type": "object",
  "required": ["access_lenses", "disclosure", "sensitivity", "document_role"],
  "properties": {
    "access_lenses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["general", "career", "publishing", "technical", "leadership", "interview", "private"] }
    },
    "disclosure": { "enum": ["internal-only", "review-required", "publish-approved"] },
    "sensitivity": { "enum": ["public", "personal", "compensation-confidential", "third-party-personal", "recruiter-confidential", "employer-confidential", "application-private", "restricted", "none"] },
    "document_role": { "enum": ["policy", "evidence", "content"] },
    "task_include": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "task_exclude": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "confidence": { "type": "string", "minLength": 1 },
    "exclude_lenses": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["general", "career", "publishing", "technical", "leadership", "interview", "private"] }
    },
    "field_visibility": {
      "type": "object",
      "additionalProperties": { "enum": ["private", "linked-projects", "career", "publishing", "public-safe"] }
    },
    "visibility": {
      "description": "Legacy compatibility field. Prefer access_lenses.",
      "enum": ["private", "linked-projects", "career", "publishing", "public-safe"]
    },
    "public_safe": {
      "description": "Legacy compatibility field. Prefer disclosure.",
      "type": "boolean"
    }
  },
  "additionalProperties": true
}
