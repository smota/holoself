{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentflow.dev/schemas/council-synthesis.schema.json",
  "title": "AgentFlow CouncilSynthesis",
  "type": "object",
  "required": [
    "version",
    "type",
    "id",
    "requestDigest",
    "ownerRole",
    "adviceDigests",
    "decision",
    "objectionDispositions",
    "status",
    "digest"
  ],
  "properties": {
    "version": { "const": 1 },
    "type": { "const": "council-synthesis" },
    "id": { "type": "string", "minLength": 1 },
    "requestDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "ownerRole": { "type": "string", "pattern": "^agentflow:" },
    "adviceDigests": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
    },
    "decision": { "type": "string", "minLength": 1 },
    "objectionDispositions": { "type": "array", "items": { "type": "object" } },
    "status": { "enum": ["complete", "blocked"] },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "additionalProperties": false
}
