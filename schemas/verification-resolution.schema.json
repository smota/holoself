{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "verification-resolution",
  "type": "object",
  "required": [
    "version",
    "type",
    "digest",
    "observationDigest",
    "candidateDigest",
    "definitionDigest",
    "status",
    "errors",
    "resolvedAt"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "type": {
      "const": "verification-resolution"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "observationDigest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "candidateDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "definitionDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "enum": ["pass", "blocked"]
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "resolvedAt": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
