{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentflow.dev/schemas/skill-catalog.schema.json",
  "title": "AgentFlow skill catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "namespace", "identityFormat", "structure", "skills", "handoffs"],
  "properties": {
    "version": { "const": 1 },
    "namespace": { "const": "agentflow" },
    "identityFormat": { "const": "<namespace>:<role>" },
    "structure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "optional"],
      "properties": {
        "required": { "const": ["SKILL.md"] },
        "optional": { "const": ["agents", "scripts", "references", "assets"] }
      }
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "qualifiedName", "source", "owns", "recognizes", "collaboratesWith"],
        "properties": {
          "role": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "qualifiedName": { "type": "string", "pattern": "^agentflow:[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "source": { "type": "string", "pattern": "^skills/[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "owns": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string" }
          },
          "recognizes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string" }
          },
          "collaboratesWith": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string" }
          }
        }
      }
    },
    "handoffs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "artifact"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "artifact": { "type": "string" }
        }
      }
    }
  }
}
