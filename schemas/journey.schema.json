{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Product journey",
  "type": "object",
  "required": ["version", "id", "job", "criteria"],
  "properties": {
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "job": {
      "type": "string",
      "minLength": 1
    },
    "required": {
      "type": "boolean"
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}
