{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://holoself.local/schemas/link.schema.json",
  "title": "Holoself activated project link",
  "type": "object",
  "required": [
    "self_context"
  ],
  "additionalProperties": false,
  "properties": {
    "project_key": {
      "type": "string",
      "pattern": "^hs-proj-[0-9a-f]{32}$",
      "description": "Random, stable identifier of this linked project; keys the self-side lens binding. Preserved across rewrites."
    },
    "self_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "access",
        "proposals",
        "index"
      ],
      "properties": {
        "self_id": {
          "type": "string",
          "pattern": "^hs-self-[0-9a-f]{32}$",
          "description": "The self root config.json self_id; resolved to a checkout through HOLOSELF_HOME or the per-machine self map."
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Legacy absolute self root path (machine-specific). New links omit it once the self resolves through the self map."
        },
        "access": {
          "const": "read"
        },
        "proposals": {
          "enum": [
            "enabled",
            "disabled"
          ]
        },
        "index": {
          "const": "local"
        },
        "binding_salt": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "cache_limit_entries": {
          "type": "integer",
          "minimum": 1,
          "deprecated": true,
          "description": "Deprecated and ignored; the on-disk decision cache has been removed."
        },
        "cache_limit_bytes": {
          "type": "integer",
          "minimum": 1,
          "deprecated": true,
          "description": "Deprecated and ignored; the on-disk decision cache has been removed."
        },
        "ledger": {
          "$ref": "#/$defs/ledger"
        }
      },
      "anyOf": [
        {
          "required": [
            "self_id"
          ]
        },
        {
          "required": [
            "path"
          ]
        }
      ]
    },
    "ledger": {
      "$ref": "#/$defs/ledger"
    },
    "cache_limit_entries": {
      "type": "integer",
      "minimum": 1,
      "deprecated": true,
      "description": "Deprecated and ignored; the on-disk decision cache has been removed."
    },
    "cache_limit_bytes": {
      "type": "integer",
      "minimum": 1,
      "deprecated": true,
      "description": "Deprecated and ignored; the on-disk decision cache has been removed."
    },
    "project_context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "include": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Legacy diagnostic field. Holoself indexes only self; domain indexing is disabled."
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "assert_include": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "assert_exclude": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "ledger": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "record_task_text": {
          "type": "boolean",
          "default": false
        }
      }
    }
  },
  "description": "Project link (.holoself/link.yaml). A portable link names its self by self_context.self_id and carries a root project_key; a legacy link names its self by an absolute self_context.path (docs/decisions/portable-links.md)."
}
