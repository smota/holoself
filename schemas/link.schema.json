{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://holoself.local/schemas/link.schema.json",
  "title": "Holoself activated project link",
  "type": "object",
  "required": [
    "self_context"
  ],
  "additionalProperties": false,
  "properties": {
    "self_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "access",
        "proposals",
        "index"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "access": {
          "const": "read"
        },
        "proposals": {
          "enum": [
            "enabled",
            "disabled"
          ]
        },
        "index": {
          "const": "local"
        },
        "binding_salt": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        }
      }
    },
    "project_context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "include": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Legacy diagnostic field. Holoself indexes only self; domain indexing is disabled."
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "assert_include": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "assert_exclude": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
