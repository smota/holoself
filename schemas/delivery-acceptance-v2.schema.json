{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Run delivery acceptance contract v2",
  "type": "object",
  "required": ["version", "goalRevision", "criteria"],
  "properties": {
    "version": {
      "const": 2
    },
    "goalRevision": {
      "type": "string",
      "minLength": 1
    },
    "ownerRole": {
      "type": "string",
      "minLength": 1
    },
    "collaborationContractDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "definitionDigest", "assertions"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "definitionDigest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "assertions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "allowedOrigins": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": ["collector-observed", "external-resolved"]
            }
          },
          "requireImmutable": {
            "type": "boolean"
          },
          "maxAgeMs": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "journeys": {
      "type": "array",
      "items": {
        "$ref": "journey.schema.json"
      }
    }
  },
  "additionalProperties": false
}
