{
  "version": 1,
  "namespace": "agentflow",
  "identityFormat": "<namespace>-<role>",
  "structure": {
    "required": ["SKILL.md"],
    "optional": ["agents", "scripts", "references", "assets"]
  },
  "skills": [
    {
      "role": "orchestrator",
      "qualifiedName": "agentflow-orchestrator",
      "source": "skills/agentflow-orchestrator",
      "owns": [
        "workflow.phase-state",
        "workflow.transition-evidence",
        "workflow.acceptance-ledger",
        "workflow.pr-readiness"
      ],
      "recognizes": ["collaborator", "scanner", "designer", "migrator", "auditor"],
      "collaboratesWith": ["collaborator", "scanner", "designer", "migrator", "auditor"]
    },
    {
      "role": "collaborator",
      "qualifiedName": "agentflow-collaborator",
      "source": "skills/agentflow-collaborator",
      "owns": [
        "collaboration.mode-selection",
        "collaboration.helper-boundaries",
        "collaboration.complexity-routing",
        "collaboration.council-policy",
        "collaboration.parent-synthesis"
      ],
      "recognizes": ["orchestrator", "scanner", "designer", "migrator", "auditor"],
      "collaboratesWith": ["orchestrator", "scanner", "auditor"]
    },
    {
      "role": "scanner",
      "qualifiedName": "agentflow-scanner",
      "source": "skills/agentflow-scanner",
      "owns": ["discovery.scope", "discovery.findings", "discovery.evidence-map"],
      "recognizes": ["orchestrator", "collaborator", "designer", "migrator", "auditor"],
      "collaboratesWith": ["orchestrator", "collaborator", "designer", "migrator", "auditor"]
    },
    {
      "role": "designer",
      "qualifiedName": "agentflow-designer",
      "source": "skills/agentflow-designer",
      "owns": [
        "definition.policy-model",
        "definition.schema-contract",
        "definition.role-boundaries"
      ],
      "recognizes": ["orchestrator", "collaborator", "scanner", "migrator", "auditor"],
      "collaboratesWith": ["orchestrator", "scanner", "migrator", "auditor"]
    },
    {
      "role": "migrator",
      "qualifiedName": "agentflow-migrator",
      "source": "skills/agentflow-migrator",
      "owns": ["adoption.inventory", "adoption.mutation-plan", "adoption.transaction"],
      "recognizes": ["orchestrator", "collaborator", "scanner", "designer", "auditor"],
      "collaboratesWith": ["orchestrator", "scanner", "designer", "auditor"]
    },
    {
      "role": "auditor",
      "qualifiedName": "agentflow-auditor",
      "source": "skills/agentflow-auditor",
      "owns": [
        "assurance.validation",
        "assurance.deterministic-acceptance-checks",
        "assurance.verdict",
        "assurance.remediation-advice"
      ],
      "recognizes": ["orchestrator", "collaborator", "scanner", "designer", "migrator"],
      "collaboratesWith": ["orchestrator", "collaborator", "scanner", "designer", "migrator"]
    }
  ],
  "handoffs": [
    {
      "from": "orchestrator",
      "to": "collaborator",
      "artifact": "collaboration-intent"
    },
    {
      "from": "collaborator",
      "to": "orchestrator",
      "artifact": "strategy-synthesis"
    },
    {
      "from": "collaborator",
      "to": "orchestrator",
      "artifact": "council-synthesis"
    },
    {
      "from": "orchestrator",
      "to": "scanner",
      "artifact": "scan-brief"
    },
    {
      "from": "scanner",
      "to": "orchestrator",
      "artifact": "evidence-map"
    },
    {
      "from": "orchestrator",
      "to": "designer",
      "artifact": "definition-change-request"
    },
    {
      "from": "designer",
      "to": "orchestrator",
      "artifact": "definition-change-set"
    },
    {
      "from": "orchestrator",
      "to": "migrator",
      "artifact": "adoption-intent"
    },
    {
      "from": "migrator",
      "to": "auditor",
      "artifact": "migration-receipt"
    },
    {
      "from": "auditor",
      "to": "orchestrator",
      "artifact": "audit-verdict"
    },
    {
      "from": "auditor",
      "to": "orchestrator",
      "artifact": "acceptance-verification"
    }
  ]
}
